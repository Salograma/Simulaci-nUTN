			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792870435907</Id>
					<Name><![CDATA[gauss]]></Name>
					<X>340</X><Y>-360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return Math.sqrt(-2 * Math.log(1 - uniform())) * Math.cos(2 * Math.PI * uniform());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Color]]></ReturnType>
					<Id>1792870478270</Id>
					<Name><![CDATA[heatColor]]></Name>
					<X>420</X><Y>-360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[t = Math.max(0, Math.min(1, t));
int[][] s = { {0, 0, 255}, {0, 255, 255}, {0, 255, 0}, {255, 255, 0}, {255, 0, 0} };
double u = t * 4;
int i = (int) Math.min(3, Math.floor(u));
double f = u - i;
return new Color(
    (int) (s[i][0] + f * (s[i + 1][0] - s[i][0])),
    (int) (s[i][1] + f * (s[i + 1][1] - s[i][1])),
    (int) (s[i][2] + f * (s[i + 1][2] - s[i][2])));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792870618415</Id>
					<Name><![CDATA[initParticles]]></Name>
					<X>520</X><Y>-360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[cellE = new double[M][M];
cellN = new int[M][M];
cellT = new double[M][M];
cellD = new double[M][M];
for (int i = 0; i < M; i++) java.util.Arrays.fill(cellT[i], T);
collisions = 0; steps = 0; impulseAcc = 0; tWin = 0;

rMax = 0;
for (int k = 0; k < particles.size(); k++) {
    Particle p = particles.get(k);
    if (k < N1) p.set_mass(m1);
    rMax = Math.max(rMax, p.radius);
}
for (Particle p : particles) {
    p.setXY(uniform(p.radius, Lx - p.radius), uniform(p.radius, Ly - p.radius));
    if (initMode == 0) {
        double v0 = Math.sqrt(2 * kB * T / p.mass);          // 1/2 m v0^2 = kB T  (2D)
        double th = uniform(0, 2 * Math.PI);
        p.vx = v0 * Math.cos(th);
        p.vy = v0 * Math.sin(th);
    } else {
        double sg = Math.sqrt(kB * T / p.mass);
        p.vx = sg * gauss();
        p.vy = sg * gauss();
    }
}
Tmeas = T;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792870661398</Id>
					<Name><![CDATA[stepPhysics]]></Name>
					<X>620</X><Y>-360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for (Particle p : particles) {
    p.setXY(p.getX() + p.vx * dt, p.getY() + p.vy * dt);
    wallBounce(p);
}
resolveCollisions();
accumulate();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792870705271</Id>
					<Name><![CDATA[wallBounce]]></Name>
					<X>340</X><Y>-400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Particle]]></Type>
					</Parameter>
					<Body><![CDATA[double x = p.getX(), y = p.getY(), r = p.radius;

if (x < r) {
    x = r;
    if (wallMode == 1) thermalKick(p, true, TL);
    else if (p.vx < 0) { impulseAcc += 2 * p.mass * (-p.vx); p.vx = -p.vx; }
} else if (x > Lx - r) {
    x = Lx - r;
    if (wallMode == 1) thermalKick(p, false, TR);
    else if (p.vx > 0) { impulseAcc += 2 * p.mass * p.vx; p.vx = -p.vx; }
}
if (y < r) {
    y = r;
    if (p.vy < 0) { impulseAcc += 2 * p.mass * (-p.vy); p.vy = -p.vy; }
} else if (y > Ly - r) {
    y = Ly - r;
    if (p.vy > 0) { impulseAcc += 2 * p.mass * p.vy; p.vy = -p.vy; }
}
p.setXY(x, y);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792870728700</Id>
					<Name><![CDATA[thermalKick]]></Name>
					<X>440</X><Y>-400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Particle]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[left]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[Twall]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[double s = Math.sqrt(kB * Twall / p.mass);
double vn = s * Math.sqrt(-2 * Math.log(1 - uniform()));
double vt = s * gauss();
double ekBefore = 0.5 * p.mass * (p.vx * p.vx + p.vy * p.vy);
impulseAcc += p.mass * (Math.abs(p.vx) + vn);
p.vx = left ? vn : -vn;
p.vy = vt;
double ekAfter = 0.5 * p.mass * (p.vx * p.vx + p.vy * p.vy);
qWall[left ? 0 : 1] += ekAfter - ekBefore;      // energía entregada (+) / absorbida (-) por la pared]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792870778458</Id>
					<Name><![CDATA[collide]]></Name>
					<X>540</X><Y>-400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[a]]></Name>
						<Type><![CDATA[Particle]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[b]]></Name>
						<Type><![CDATA[Particle]]></Type>
					</Parameter>
					<Body><![CDATA[double dx = b.getX() - a.getX(), dy = b.getY() - a.getY();
double minD = a.radius + b.radius;
double d2 = dx * dx + dy * dy;
if (d2 >= minD * minD || d2 == 0) return;

double d = Math.sqrt(d2), nx = dx / d, ny = dy / d;

// separación posicional (anti-solapamiento)
double ov = 0.5 * (minD - d);
a.setXY(a.getX() - nx * ov, a.getY() - ny * ov);
b.setXY(b.getX() + nx * ov, b.getY() + ny * ov);

// velocidad relativa sobre la normal; sólo hay choque si SE ACERCAN
double kx = a.vx - b.vx, ky = a.vy - b.vy;
double vnRel = kx * nx + ky * ny;
if (vnRel <= 0) return;

double j = 2 * vnRel / (a.mass + b.mass);
a.vx -= j * b.mass * nx;  a.vy -= j * b.mass * ny;
b.vx += j * a.mass * nx;  b.vy += j * a.mass * ny;
a.nCol++; b.nCol++; collisions++;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792870832426</Id>
					<Name><![CDATA[resolveCollisions]]></Name>
					<X>340</X><Y>-440</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int n = particles.size();
int gx = Math.max(1, (int) (Lx / (2 * rMax)));
int gy = Math.max(1, (int) (Ly / (2 * rMax)));
double cw = Lx / gx, ch = Ly / gy;
int[] head = new int[gx * gy];
java.util.Arrays.fill(head, -1);
int[] nxt = new int[n];

for (int i = 0; i < n; i++) {
    Particle p = particles.get(i);
    int cx = (int) Math.min(gx - 1, Math.max(0, p.getX() / cw));
    int cy = (int) Math.min(gy - 1, Math.max(0, p.getY() / ch));
    int c = cy * gx + cx;
    nxt[i] = head[c];
    head[c] = i;
}
int[][] off = { {1, 0}, {-1, 1}, {0, 1}, {1, 1} };
for (int cy = 0; cy < gy; cy++) {
    for (int cx = 0; cx < gx; cx++) {
        for (int i = head[cy * gx + cx]; i != -1; i = nxt[i]) {
            for (int j = nxt[i]; j != -1; j = nxt[j])
                collide(particles.get(i), particles.get(j));
            for (int[] o : off) {
                int mx = cx + o[0], my = cy + o[1];
                if (mx < 0 || mx >= gx || my < 0 || my >= gy) continue;
                for (int j = head[my * gx + mx]; j != -1; j = nxt[j])
                    collide(particles.get(i), particles.get(j));
            }
        }
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792870854152</Id>
					<Name><![CDATA[accumulate]]></Name>
					<X>460</X><Y>-440</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double E = 0, v2sum = 0;
for (Particle p : particles) {
    double v2 = p.vx * p.vx + p.vy * p.vy;
    double ek = 0.5 * p.mass * v2;
    E += ek;
    v2sum += v2;
    int i = (int) Math.min(M - 1, Math.max(0, p.getX() / Lx * M));
    int j = (int) Math.min(M - 1, Math.max(0, p.getY() / Ly * M));
    cellE[i][j] += ek;
    cellN[i][j]++;
}
Etot = E;
Tmeas = E / (particles.size() * kB);            // 2D: <Ek> = kB T
vrms = Math.sqrt(v2sum / particles.size());
tWin += dt;
steps++;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792870866605</Id>
					<Name><![CDATA[updateHeatMap]]></Name>
					<X>560</X><Y>-440</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double a = 0.3;
for (int i = 0; i < M; i++) {
    for (int j = 0; j < M; j++) {
        if (cellN[i][j] > 0) {
            double tl = cellE[i][j] / cellN[i][j] / kB;
            cellT[i][j] = (1 - a) * cellT[i][j] + a * tl;
        }
        double dens = steps > 0 ? cellN[i][j] / (double) steps : 0;   // partículas promedio en la celda
        cellD[i][j] = (1 - a) * cellD[i][j] + a * dens;
        cellE[i][j] = 0;
        cellN[i][j] = 0;
    }
}
if (profT == null || profT.length != M) { profT = new double[M]; java.util.Arrays.fill(profT, T); }
dsProfile.reset();
for (int i = 0; i < M; i++) {
    double s = 0;
    for (int j = 0; j < M; j++) s += cellT[i][j];
    profT[i] = 0.9 * profT[i] + 0.1 * (s / M);     // suavizado extra: cada columna tiene pocas partículas
    dsProfile.add((i + 0.5) * Lx / M, profT[i]);
}
steps = 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Color]]></ReturnType>
					<Id>1792870883965</Id>
					<Name><![CDATA[cellColor]]></Name>
					<X>680</X><Y>-440</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idx]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[int i = idx % M, j = idx / M;
double t;
if (mapMode == 0) t = (cellT[i][j] - Tmin) / (Tmax - Tmin);
else              t = cellD[i][j] / (2.0 * particles.size() / (M * M));   // 2x la densidad media = rojo
Color c = heatColor(t);
return new Color(c.getRed(), c.getGreen(), c.getBlue(), 120);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792870909921</Id>
					<Name><![CDATA[updatePressure]]></Name>
					<X>620</X><Y>-400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double Lxe = Lx - 2 * rMax, Lye = Ly - 2 * rMax;          // región accesible a los centros
if (tWin > 0) pressure = impulseAcc / (tWin * 2 * (Lxe + Lye));
pIdeal = particles.size() * kB * Tmeas / (Lxe * Lye);     // P A = N kB T
impulseAcc = 0; tWin = 0;
if (tWin > 0) { qL = qWall[0] / tWin; qR = qWall[1] / tWin; }
qWall[0] = 0; qWall[1] = 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792870926524</Id>
					<Name><![CDATA[updateHistogram]]></Name>
					<X>340</X><Y>-480</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double mRef = massFilter > 0 ? massFilter : 1.0;
double sig2 = kB * Tmeas / mRef;
double sig = Math.sqrt(sig2);
double vMax = 283, dv = vMax / nBins;   // parámetro, ej. 4*sqrt(5000) = 283
int[] cnt = new int[nBins];
int n = 0;
for (Particle p : particles) {
    if (massFilter > 0 && Math.abs(p.mass - massFilter) > 1e-9) continue;
    n++;
    int b = (int) (Math.sqrt(p.vx * p.vx + p.vy * p.vy) / dv);
    if (b < nBins) cnt[b]++;
}
dsObs.reset(); dsTheo.reset();
for (int b = 0; b < nBins; b++) {
    double lo = b * dv, hi = (b + 1) * dv, vc = 0.5 * (lo + hi);
    dsObs.add(vc, cnt[b]);
    dsTheo.add(vc, n * (Math.exp(-lo*lo/(2*sig2)) - Math.exp(-hi*hi/(2*sig2))));
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792870939073</Id>
					<Name><![CDATA[chiSquare]]></Name>
					<X>480</X><Y>-480</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int k = kQ, n = particles.size();
int[] O = new int[k];
for (Particle p : particles) {
    double v2 = p.vx * p.vx + p.vy * p.vy;
    double F = 1 - Math.exp(-p.mass * v2 / (2 * kB * Tmeas));
    O[(int) Math.min(k - 1, Math.floor(F * k))]++;
}
double Ei = n / (double) k, chi = 0;
for (int b = 0; b < k; b++) chi += (O[b] - Ei) * (O[b] - Ei) / Ei;
chi2val = chi;
// Si no compila el import, usar el valor tabulado: gl = 8 -> 15.51
org.apache.commons.math3.distribution.ChiSquaredDistribution cd =
    new org.apache.commons.math3.distribution.ChiSquaredDistribution(k - 2);
chi2crit = cd.inverseCumulativeProbability(0.95);
pValue = 1 - cd.cumulativeProbability(chi);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792870952507</Id>
					<Name><![CDATA[setTemperature]]></Name>
					<X>580</X><Y>-480</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[newT]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[double f = Math.sqrt(newT / Tmeas);
for (Particle p : particles) { p.vx *= f; p.vy *= f; }
T = newT;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792870968303</Id>
					<Name><![CDATA[setN]]></Name>
					<X>700</X><Y>-480</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[newN]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[while (particles.size() < newN) {
    Particle p = add_particles();
    p.setXY(uniform(p.radius, Lx - p.radius), uniform(p.radius, Ly - p.radius));
    double sg = Math.sqrt(kB * Tmeas / p.mass);
    p.vx = sg * gauss();
    p.vy = sg * gauss();
}
while (particles.size() > newN)
    remove_particles(particles.get(particles.size() - 1));
N = newN;]]></Body>
				</Function>
