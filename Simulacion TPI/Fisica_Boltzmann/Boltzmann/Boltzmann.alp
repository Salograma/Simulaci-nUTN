			<AdditionalClassCode><![CDATA[// ---------------- Resultados de experimentos con varias replicas (semillas distintas) ----------------
public static java.util.ArrayList<double[]> runResults = new java.util.ArrayList<double[]>();

public static void runsClear() { runResults.clear(); }

// Guarda una corrida: v[0] = clave del grupo (T, m1, N, dt...), el resto son las salidas.
// Usar Double.NaN para un valor no disponible.
public static void runsAdd(double... v) { runResults.add(v.clone()); }

// t de Student critico, bilateral al 5 %, para gl = 1..30
public static double tCrit(int gl) {
    double[] t = { 12.706, 4.303, 3.182, 2.776, 2.571, 2.447, 2.365, 2.306, 2.262, 2.228,
                   2.201, 2.179, 2.160, 2.145, 2.131, 2.120, 2.110, 2.101, 2.093, 2.086,
                   2.080, 2.074, 2.069, 2.064, 2.060, 2.056, 2.052, 2.048, 2.045, 2.042 };
    return (gl >= 1 && gl <= 30) ? t[gl - 1] : 1.96;
}

private static java.util.TreeMap<Double, java.util.ArrayList<double[]>> runsGroups() {
    java.util.TreeMap<Double, java.util.ArrayList<double[]>> g = new java.util.TreeMap<Double, java.util.ArrayList<double[]>>();
    for (double[] r : runResults) {
        if (!g.containsKey(r[0])) g.put(r[0], new java.util.ArrayList<double[]>());
        g.get(r[0]).add(r);
    }
    return g;
}

// CSV de todas las corridas + media y desvio de cada columna por grupo + test t pareado (colEst vs colTeo; 0 y 0 lo omite).
public static void runsReport(String header, int colEst, int colTeo) {
    String[] names = header.split(",");
    System.out.println(header);
    for (double[] r : runResults) {
        StringBuilder sb = new StringBuilder();
        for (int c = 0; c < r.length; c++) { if (c > 0) sb.append(","); sb.append(r[c]); }
        System.out.println(sb);
    }
    for (java.util.Map.Entry<Double, java.util.ArrayList<double[]>> e : runsGroups().entrySet()) {
        java.util.ArrayList<double[]> L = e.getValue();
        System.out.println("--- " + names[0] + " = " + e.getKey() + "   (replicas: " + L.size() + ")");
        for (int c = 1; c < L.get(0).length; c++) {
            double s1 = 0, s2 = 0; int k = 0;
            for (double[] r : L) {
                if (Double.isNaN(r[c])) continue;
                s1 += r[c]; s2 += r[c] * r[c]; k++;
            }
            if (k == 0) { System.out.println("    " + (c < names.length ? names[c] : "col" + c) + ": sin datos"); continue; }
            double mean = s1 / k;
            double sd = k > 1 ? Math.sqrt(Math.max(0, (s2 - k * mean * mean) / (k - 1))) : 0;
            System.out.println("    " + (c < names.length ? names[c] : "col" + c) + ": media = " + mean + "   sd = " + sd + "   (validas: " + k + ")");
        }
    }
    if (colEst > 0 || colTeo > 0) runsTests(header, colEst, colTeo);
}

// Test t pareado por grupo: (columna colEst) - (columna colTeo). La columna 0 (la clave) tambien vale como colTeo.
public static void runsTests(String header, int colEst, int colTeo) {
    String[] names = header.split(",");
    for (java.util.Map.Entry<Double, java.util.ArrayList<double[]>> e : runsGroups().entrySet()) {
        double sd1 = 0, sd2 = 0, rel = 0, teoSum = 0; int n = 0;
        for (double[] r : e.getValue()) {
            if (Double.isNaN(r[colEst]) || Double.isNaN(r[colTeo])) continue;
            double d = r[colEst] - r[colTeo];
            sd1 += d; sd2 += d * d; teoSum += Math.abs(r[colTeo]);
            if (r[colTeo] != 0) rel += r[colEst] / r[colTeo] - 1;
            n++;
        }
        if (n < 2) { System.out.println("TEST (" + names[colEst] + " - " + names[colTeo] + ") " + names[0] + " = " + e.getKey() + ": menos de 2 corridas validas"); continue; }
        double md = sd1 / n;
        double sdd = Math.sqrt(Math.max(0, (sd2 - n * md * md) / (n - 1)));
        double t = sdd > 0 ? md / (sdd / Math.sqrt(n)) : (md == 0 ? 0 : Double.POSITIVE_INFINITY);
        double tc = tCrit(n - 1);
        System.out.println("TEST t pareado (" + names[colEst] + " - " + names[colTeo] + ")  " + names[0] + " = " + e.getKey()
            + ":  diferencia media = " + md
            + (teoSum > 0 ? ",  error relativo medio = " + (100.0 * rel / n) + " %" : "")
            + ",  t = " + t + ",  t critico (5 %, gl = " + (n - 1) + ") = " + tc
            + "  ->  " + (Math.abs(t) > tc ? "SE RECHAZA H0" : "NO se rechaza H0"));
    }
}

// Ajuste por el origen y = a * sqrt(clave) con todas las corridas (por ejemplo <v> contra sqrt(T)); compara a con aTeo.
public static void runsFitSqrt(int colY, double aTeo) {
    double sxy = 0, sxx = 0; int n = 0;
    for (double[] r : runResults) {
        if (Double.isNaN(r[colY])) continue;
        double x = Math.sqrt(r[0]);
        sxy += x * r[colY]; sxx += x * x; n++;
    }
    if (n < 3 || sxx <= 0) { System.out.println("AJUSTE: datos insuficientes"); return; }
    double a = sxy / sxx, ss = 0;
    for (double[] r : runResults) {
        if (Double.isNaN(r[colY])) continue;
        double d = r[colY] - a * Math.sqrt(r[0]);
        ss += d * d;
    }
    double se = Math.sqrt(ss / (n - 1) / sxx);
    double t = se > 0 ? (a - aTeo) / se : 0;
    System.out.println("AJUSTE y = a * sqrt(clave):  a = " + a + " +- " + se + "   teorico = " + aTeo
        + "   t = " + t + "  (t critico 5 % = " + tCrit(n - 1) + ")  ->  " + (Math.abs(t) > tCrit(n - 1) ? "SE RECHAZA H0" : "NO se rechaza H0")
        + "   (n = " + n + " corridas)");
}
]]></AdditionalClassCode>
			<StartupCode><![CDATA[initParticles();
if (batchEsc == 4) startJoule();       // experimento del Escenario 4: arranca con el tabique puesto
