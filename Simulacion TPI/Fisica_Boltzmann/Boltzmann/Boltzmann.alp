		<!--   =========  Parameter Variation Experiment   ========  -->
		<ParamVariationExperiment ActiveObjectClassId="1792867900072">
			<Id>1796000001000</Id>
			<Name><![CDATA[Esc1_Temperatura]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<InitialSetupCode><![CDATA[Main.runsClear();]]></InitialSetupCode>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>randomSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<AfterSimulationRunCode><![CDATA[Main.runsAdd(root.T, root.bavg(0), Math.sqrt(Math.PI * root.kB * root.T / 2), root.bavg(1), Math.sqrt(2 * root.kB * root.T), root.chiN > 0 ? root.chiRej / (double) root.chiN : Double.NaN, root.bavg(2));]]></AfterSimulationRunCode>
			<SeedValue>1</SeedValue>
			<SelectionModeForSimultaneousEvents>LIFO</SelectionModeForSimultaneousEvents>
			<VmArgs><![CDATA[]]></VmArgs>
			<LoadRootFromSnapshot>false</LoadRootFromSnapshot>


			<AfterExperimentCode><![CDATA[Main.runsReport("T,vMed,vTeo,vrmsMed,vrmsTeo,chiFrac,Tmed", 1, 2); Main.runsTests("T,vMed,vTeo,vrmsMed,vrmsTeo,chiFrac,Tmed", 3, 4); Main.runsTests("T,vMed,vTeo,vrmsMed,vrmsTeo,chiFrac,Tmed", 6, 0); Main.runsFitSqrt(1, Math.sqrt(Math.PI / 2));]]></AfterExperimentCode>
			<AllowParallelEvaluations>false</AllowParallelEvaluations>
			<UseFreeformParameters>false</UseFreeformParameters>
			<NumberOfRuns>10</NumberOfRuns>
