dsVTheo.add(0, 0);
dsVTheo.add(75, 75 * s);                    // 75 ≈ √5000 con margen
for (double u = 0; u <= 5; u += 0.05) dsHTheo.add(u, u * Math.exp(-u*u/2));]]></StartupCode>
