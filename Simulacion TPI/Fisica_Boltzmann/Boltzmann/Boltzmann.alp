				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1795000000005</Id>
					<Name><![CDATA[setScenario]]></Name>
					<X>50</X><Y>-700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[k]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[set_M(k == 3 ? 20 : 10);  
escenario = k;

// 1) parametros de partida del escenario
int nTarget = 250;
double rTarget = 5;
T = 1250; TL = 2500; TR = 500; Tmin = 0; Tmax = 2500;
initMode = 1; N1 = 0; massFilter = 0; m1 = 4;
switch (k) {
    case 1: wallMode = 0; mapMode = 0; break;
    case 2: wallMode = 0; mapMode = 0; N1 = 50; break;
    case 3: wallMode = 1; mapMode = 0; nTarget = 1000; rTarget = 2.5; break;
    case 4: wallMode = 0; mapMode = 1; break;
}

// 2) poblacion y radio
rPart = rTarget;
setN(nTarget);
for (Particle p : particles) p.set_radius(rTarget);

// 3) sincronizar los controles de pantalla (sin disparar sus acciones)
Ns.setValue(nTarget, false);
Temperatura.setValue(T, false);
radioParedes.setValue(wallMode, false);
radioMapa.setValue(mapMode, false);
radioInit.setValue(0, false);

// 4) reiniciar (el escenario 4 arranca con el tabique puesto)
if (k == 4) startJoule(); else restart();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[]]></ReturnType>
					<Id>1796000000050</Id>
					<Name><![CDATA[batchTick]]></Name>
					<X>900</X><Y>-590</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Solo se usa en los experimentos (batchEsc != 0). Se llama desde ev_snap, cada 0.5 s de modelo.
// batchEsc: 1 = Escenario 1, 2 = Escenario 2, 3 = Escenario 3, 4 = Escenario 4 (Joule). 0 = modo interactivo.
if (batchEsc == 4 && partition && time() >= 2.0) {      // E4: se retira el tabique a los 2 s
    removePartition();
    tRem = time();
}
if (E0 > 0) bLastE = Etot / E0;
if (batchEsc == 4 && !partition && tRem >= 0) {
    double t = time() - tRem;
    double tol = 2 * 0.5 / Math.sqrt(particles.size());   // 2 sigma de la fluctuacion de fracLeft (sigma = 0.5 / sqrt(N))
    if (bTHalf < 0 && fracLeft <= 0.75) bTHalf = t;       // mitad del exceso (de 1 a 0.5)
    if (bTEq < 0 && Math.abs(fracLeft - 0.5) <= tol) bTEq = t;
}
if (time() < tPrep) return;                              // descartar el transitorio
bN++;
bAcc[0]  += meanSpeed();
bAcc[1]  += vrms;
bAcc[2]  += Tmeas;
bAcc[3]  += meanEk(1.0);
bAcc[4]  += (N1 > 0 ? meanEk(m1) : 0);
bAcc[5]  += slopeT;
bAcc[6]  += r2T;
bAcc[7]  += jumpL;
bAcc[8]  += jumpR;
bAcc[9]  += qL;
bAcc[10] += qR;
bAcc[11] += fracLeft;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1796000000051</Id>
					<Name><![CDATA[bavg]]></Name>
					<X>900</X><Y>-540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[i]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[return bN > 0 ? bAcc[i] / bN : Double.NaN;]]></Body>
				</Function>
