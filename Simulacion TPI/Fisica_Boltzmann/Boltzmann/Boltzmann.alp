				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793800000010</Id>
					<Name><![CDATA[analyzeProfile]]></Name>
					<X>1500</X><Y>-400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Escenario 3: ajuste lineal de la zona central del perfil T(x) y salto de temperatura en las paredes
dsFit.reset();
if (wallMode == 1 && profT != null) {
    int i0 = (int) Math.round(0.25 * M), i1 = (int) Math.round(0.75 * M);   // zona central
    double n = i1 - i0, sx = 0, sy = 0, sxx = 0, sxy = 0, syy = 0;
    for (int i = i0; i < i1; i++) {
        double x = (i + 0.5) * Lx / M, y = profT[i];
        sx += x; sy += y; sxx += x * x; sxy += x * y; syy += y * y;
    }
    double den = n * sxx - sx * sx;
    if (den > 0) {
        slopeT = (n * sxy - sx * sy) / den;
        interceptT = (sy - slopeT * sx) / n;
        double ssTot = syy - sy * sy / n;
        double ssRes = syy - interceptT * sy - slopeT * sxy;
        r2T = ssTot > 0 ? 1 - ssRes / ssTot : 0;
        jumpL = TL - interceptT;                          // T pared izq - T del gas extrapolada en x = 0
        jumpR = TR - (interceptT + slopeT * Lx);          // T pared der - T del gas extrapolada en x = Lx
        dsFit.add(0, interceptT);
        dsFit.add(Lx, interceptT + slopeT * Lx);
    }
} else {
    slopeT = 0; interceptT = 0; r2T = 0; jumpL = 0; jumpR = 0;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793149815956</Id>
					<Name><![CDATA[meanSpeed]]></Name>
					<X>740</X><Y>-360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double s = 0;
for (Particle p : particles) s += Math.sqrt(p.vx*p.vx + p.vy*p.vy);
return s / particles.size();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793152271329</Id>
					<Name><![CDATA[guardarHist]]></Name>
					<X>800</X><Y>-480</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[k]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[DataSet obs = (k == 1) ? dsH1 : (k == 2) ? dsH2 : dsH3;

double mRef = massFilter > 0 ? massFilter : 1.0;
double sig = Math.sqrt(kB * Tmeas / mRef);
double dv = vMaxFixed / nBins;

double n = 0;                                    // partículas de la especie filtrada
for (Particle p : particles)
    if (massFilter == 0 || Math.abs(p.mass - massFilter) < 1e-9) n++;

obs.reset();
for (int i = 0; i < dsObs.size(); i++) {
    double u = dsObs.getX(i) / sig;
    double f = (dsObs.getY(i) / (n * dv)) * sig;
    obs.add(u, f);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793153418602</Id>
					<Name><![CDATA[meanEk]]></Name>
					<X>560</X><Y>-540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[m]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[double sum = 0; int c = 0;
for (Particle p : particles) {
    if (Math.abs(p.mass - m) > 1e-9) continue;
    sum += 0.5 * p.mass * (p.vx*p.vx + p.vy*p.vy);
    c++;
}
return c > 0 ? sum / c : 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793153450051</Id>
					<Name><![CDATA[vrmsOf]]></Name>
					<X>680</X><Y>-540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[m]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[double sum = 0; int c = 0;
for (Particle p : particles) {
    if (Math.abs(p.mass - m) > 1e-9) continue;
    sum += p.vx*p.vx + p.vy*p.vy;
    c++;
}
return c > 0 ? Math.sqrt(sum / c) : 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
