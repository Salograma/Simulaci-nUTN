		<ActiveObjectClass>
			<Id>1793206775859</Id>
			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[int M = 50000;
int N = 10000;
double[] teorico = {1.0, 1.0, 0.340537, 0.193206};

for (int d = 1; d <= 4; d++) {
    double p = retornoMC(d, M, N);
    double se = Math.sqrt(p * (1 - p) / M);
    traceln("d=" + d
        + "  p=" + p
        + "  IC95%=[" + (p - 1.96 * se) + ", " + (p + 1.96 * se) + "]");

    if (d >= 3) {
        double p0 = teorico[d - 1];
        double z = (p - p0) / Math.sqrt(p0 * (1 - p0) / M);
        traceln("     Z vs Polya = " + z + (Math.abs(z) < 1.96 ? "  -> valida" : "  -> rechaza"));
    }
}]]></StartupCode>
			<Generic>false</Generic>
			<GenericParameter>
				<Id>1793206775862</Id>
				<Name><![CDATA[1793206775862]]></Name>
				<GenericParameterValue Class="CodeValue">
