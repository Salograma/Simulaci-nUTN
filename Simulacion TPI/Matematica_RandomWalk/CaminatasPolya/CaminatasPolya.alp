			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793208417993</Id>
					<Name><![CDATA[retornoMC]]></Name>
					<X>300</X><Y>-140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[d]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[M]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[N]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[int retornos = 0;

for (int rep = 0; rep < M; rep++ ){
	int x = 0, y = 0, z = 0, w = 0;
	
	for (int s = 1; s <= N; s++){
		int dir = uniform_discr(0, 2 * d - 1);
		if (dir == 0)x++;
		else if (dir == 1)x--;
		else if (dir == 2)y++;
		else if (dir == 3)y--;
		else if (dir == 4)z++;
		else if (dir == 5)z--;
		else if (dir == 6)w++;
		else if (dir == 7)w--;
		
		if (x == 0 && y == 0 && z == 0 && w == 0){
			retornos++;
			break;
		}
	}
}

return (double) retornos / M;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793365478860</Id>
					<Name><![CDATA[verificarIsotropia]]></Name>
					<X>455</X><Y>-120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[M]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[N]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[fijarSemilla(0);   // verificación reproducible: semilla semillaBase
String[] ejes = {"x","y","z","w"};

for (int d = 1; d <= 4; d++){
	double[] r = estadisticasPosicion(d, M, N);
	
	for (int i = 0; i < d; i++){
		double media = r[2*i];
		double standardError = r[2*i+1];
		double limiteInferior = media - 1.96 * standardError;
		double limiteSuperior = media + 1.96 * standardError;
		boolean pasa = limiteInferior <= 0 && 0 <= limiteSuperior;
		
		traceln("d=" + d + "	E[" + ejes[i] + "]=" + media 
		+ "	IC95%=[" + limiteInferior + ", " + limiteSuperior +
		 "]" + (pasa ? "-> pasa" : " -> no pasa"));
	}
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1793366339065</Id>
					<Name><![CDATA[estadisticasPosicion]]></Name>
					<X>300</X><Y>-160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[d]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[M]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[N]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[double[] suma = new double[4];
double[] sumaCuad = new double[4];

for (int rep = 0; rep < M; rep++){
	int x = 0, y = 0, z = 0, w = 0;
	
	for (int s = 1; s <= N; s++){
		int dir = uniform_discr(0, 2*d-1);
		
		if (dir == 0) x++;
        else if (dir == 1) x--;
        else if (dir == 2) y++;
        else if (dir == 3) y--;
        else if (dir == 4) z++;
        else if (dir == 5) z--;
        else if (dir == 6) w++;
        else if (dir == 7) w--;
	}
	
	suma[0] += x; sumaCuad[0] += (double) x * x;
	suma[1] += y; sumaCuad[1] += (double) y * y;
	suma[2] += z; sumaCuad[2] += (double) z * z;
	suma[3] += w; sumaCuad[3] += (double) w * w;
}

double[] resultado = new double[8];

for (int i = 0; i < 4; i++){
	double media = suma[i] / M;
	double varianza = sumaCuad[i] / M - media * media;
	resultado[2*i] = media;
	resultado[2*i+1] = Math.sqrt(varianza/M); //error estandar de la media
}

return resultado;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793366960349</Id>
					<Name><![CDATA[validarPolya]]></Name>
					<X>300</X><Y>-120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[M]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[N]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// Validación: P(retorno) simulada en nCorridas corridas vs. valor teórico (prueba t, alfa = 0.05).
traceln("=== Validación contra Pólya | " + encabezadoCorridas(M, N) + " ===");
double[][] todas = new double[4][];
for (int d = 1; d <= 4; d++) {
    todas[d - 1] = pCorridas(d, M, N, semillaBase);
    resumir("d = " + d, todas[d - 1], teoricoRetorno(d, N));
}
guardarCorridas("validacion_corridas.csv", new String[] { "p_1D", "p_2D", "p_3D", "p_4D" }, todas);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1793388800531</Id>
					<Name><![CDATA[estadisticasR2]]></Name>
					<X>455</X><Y>-160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[d]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[M]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[N]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[double sumaR2 = 0;
double sumaR2Cuad = 0;

for (int rep = 0; rep < M; rep++) {
    int x = 0, y = 0, z = 0, w = 0;

    for (int s = 1; s <= N; s++) {
        int dir = uniform_discr(0, 2 * d - 1);

        if (dir == 0) x++;
        else if (dir == 1) x--;
        else if (dir == 2) y++;
        else if (dir == 3) y--;
        else if (dir == 4) z++;
        else if (dir == 5) z--;
        else if (dir == 6) w++;
        else if (dir == 7) w--;
    }

    double r2 = x * x + y * y + z * z + w * w;
    sumaR2 += r2;
    sumaR2Cuad += r2 * r2;
}

double media = sumaR2 / M;
double varianza = sumaR2Cuad / M - media * media;
double standardError = Math.sqrt(varianza / M);

return new double[] { media, standardError };]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793388934577</Id>
					<Name><![CDATA[verificarDifusion]]></Name>
					<X>610</X><Y>-160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[M]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[N]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[fijarSemilla(0);   // verificación reproducible: semilla semillaBase
for (int d = 1; d <= 4; d++) {
    double[] r = estadisticasR2(d, M, N);
    double media = r[0];
    double standardError = r[1];
    double limiteInferior = media - 1.96 * standardError;
    double limiteSuperior = media + 1.96 * standardError;
    boolean pasa = limiteInferior <= N && N <= limiteSuperior;

    traceln("d=" + d + "  E[R2]=" + media
        + "  IC95%=[" + limiteInferior + ", " + limiteSuperior + "]"
        + "  esperado=" + N
        + (pasa ? "  -> pasa" : "  -> no pasa"));
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[long[]]]></ReturnType>
					<Id>1793392203436</Id>
					<Name><![CDATA[contarVisitasOrigen]]></Name>
					<X>455</X><Y>-140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[d]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[M]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[N]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[long visitasImpares = 0;
long visitasPares = 0;

for (int rep = 0; rep < M; rep++) {
    int x = 0, y = 0, z = 0, w = 0;

    for (int s = 1; s <= N; s++) {
        int dir = uniform_discr(0, 2 * d - 1);

        if (dir == 0) x++;
        else if (dir == 1) x--;
        else if (dir == 2) y++;
        else if (dir == 3) y--;
        else if (dir == 4) z++;
        else if (dir == 5) z--;
        else if (dir == 6) w++;
        else if (dir == 7) w--;
        
        if(x == 0 && y == 0 && z == 0 && w == 0){
			if (s % 2 == 0) visitasPares++;
			else visitasImpares++;
		}
    }
}

return new long[] { visitasPares, visitasImpares };]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
