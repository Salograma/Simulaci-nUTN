				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793970099437</Id>
					<Name><![CDATA[calcularCurva]]></Name>
					<X>610</X><Y>-120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Curva P(retorno <= N) para la dimensión elegida, promediada sobre nCorridas corridas
// independientes (cada una con su semilla) y con su banda de confianza del 95 %.
int d = dimensionSel;
int bins = Npasos / 2;
traceln("=== Curva de retorno, d = " + d + " | " + encabezadoCorridas(Mreplicas, Npasos) + " ===");

double[][] r = curvaCorridas(d, Mreplicas, Npasos);

curvaRetorno.reset();
curvaICinf.reset();
curvaICsup.reset();
int salto = Math.max(1, bins / 200);
for (int k = salto; k <= bins; k += salto) {
    curvaRetorno.add(2.0 * k, r[0][k]);
    curvaICinf.add(2.0 * k, r[1][k]);
    curvaICsup.add(2.0 * k, r[2][k]);
}

double teo = teoricoRetorno(d, Npasos);
curvaPolya.reset();
if (!Double.isNaN(teo)) {
    curvaPolya.add(0, teo);
    curvaPolya.add(Npasos, teo);
}

double[] res = resumir("P(retorno <= N)", r[3], teo);
pFinal = res[0];

int n = r[3].length;
datosCorridas.reset();
for (int i = 0; i < n; i++) datosCorridas.add(i + 1, r[3][i]);
mediaCorridas.reset();
mediaCorridas.add(1, res[0]);
mediaCorridas.add(n, res[0]);
polyaCorridas.reset();
if (!Double.isNaN(teo)) {
    polyaCorridas.add(1, teo);
    polyaCorridas.add(n, teo);
}

resumenTexto = "d = " + d + "   |   n = " + n + " corridas  x  M = " + Mreplicas + " caminatas,  N = " + Npasos + " pasos\n"
    + "P(retorno <= N):  media = " + fmt(res[0]) + "    IC95% = [" + fmt(res[2]) + ", " + fmt(res[3]) + "]\n"
    + "Desvío entre corridas = " + fmt(res[1]) + "    Valor teórico = "
    + (Double.isNaN(teo) ? "1 (solo para N -> infinito)" : fmt(teo));

guardarCorridas("corridas_curva_d" + d + ".csv", new String[] { "p_retorno" }, new double[][] { r[3] });]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
