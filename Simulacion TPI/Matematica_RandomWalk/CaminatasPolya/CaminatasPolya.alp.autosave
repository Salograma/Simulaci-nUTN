				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793970099437</Id>
					<Name><![CDATA[calcularCurva]]></Name>
					<X>610</X><Y>-120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int d = dimensionSel;
int bins = Npasos / 2;
long[] primeros = new long[bins + 1];

for (int rep = 0; rep < Mreplicas; rep++){
	int x = 0, y = 0, z = 0, w = 0;
	
	for (int s = 1; s <= Npasos; s++){
		int dir = uniform_discr(0, 2 * d - 1);
		
		if (dir == 0) x++;
        else if (dir == 1) x--;
        else if (dir == 2) y++;
        else if (dir == 3) y--;
        else if (dir == 4) z++;
        else if (dir == 5) z--;
        else if (dir == 6) w++;
        else if (dir == 7) w--;
        
        if (x == 0 && y == 0 && z == 0 && w == 0) {
            primeros[s / 2]++;
            break;
        }
	}
}

curvaRetorno.reset();
long acumulado = 0;
int salto = Math.max(1, bins / 200);

for (int k = 1; k <= bins; k++){
	acumulado += primeros[k];
	if(k % salto == 0 || k == bins){
		curvaRetorno.add(2.0 * k, (double) acumulado / Mreplicas);
	}
}
pFinal = (double) acumulado / Mreplicas;

double[] teorico = {1.0, 1.0, 0.340537, 0.193206};
curvaPolya.reset();
curvaPolya.add(0, teorico[d - 1]);
curvaPolya.add(Npasos, teorico[d - 1]);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794067152986</Id>
					<Name><![CDATA[reiniciarCaminante]]></Name>
					<X>610</X><Y>-80</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Walker caminante = walker.get(0);
caminante.set_dimension(dimensionSel);
caminante.x = 0;
caminante.y = 0;
caminante.z = 0;
caminante.w = 0;
caminante.steps = 0;
caminante.returned = false;
caminante.returnTime = 0;
caminante.entradasW0 = 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1794195442903</Id>
					<Name><![CDATA[curvaAcumulada]]></Name>
					<X>800</X><Y>-160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[d]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[M]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[N]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[int bins = N / 2;
long[] primeros = new long[bins + 1];

for (int rep = 0; rep < M; rep++) {
    int x = 0, y = 0, z = 0, w = 0;

    for (int s = 1; s <= N; s++) {
        int dir = uniform_discr(0, 2 * d - 1);

        if (dir == 0) x++;
        else if (dir == 1) x--;
        else if (dir == 2) y++;
        else if (dir == 3) y--;
        else if (dir == 4) z++;
        else if (dir == 5) z--;
        else if (dir == 6) w++;
        else if (dir == 7) w--;

        if (x == 0 && y == 0 && z == 0 && w == 0) {
            primeros[s / 2]++;
            break;
        }
    }
}

double[] acumulada = new double[bins + 1];
long suma = 0;

for (int k = 1; k <= bins; k++) {
    suma += primeros[k];
    acumulada[k] = (double) suma / M;
}

return acumulada;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794195697871</Id>
					<Name><![CDATA[escenario1]]></Name>
					<X>800</X><Y>-140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[M]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[N]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[DataSet[] datasets = { curva1D, curva2D, curva3D, curva4D };
double[] teorico = {1.0, 1.0, 0.340537, 0.193206};
int bins = N / 2;
int salto = Math.max(1, bins / 200);

for (int d = 1; d <= 4; d++) {
    double[] acum = curvaAcumulada(d, M, N);

    datasets[d - 1].reset();
    for (int k = salto; k <= bins; k += salto) {
        datasets[d - 1].add(2.0 * k, acum[k]);
    }

    double p = acum[bins];
    double standardError = Math.sqrt(p * (1 - p) / M);
    traceln("d=" + d + "  p=" + p
        + "  IC95%=[" + (p - 1.96 * standardError)
        + ", " + (p + 1.96 * standardError) + "]"
        + "  Polya=" + teorico[d - 1]);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794198009076</Id>
					<Name><![CDATA[escenario2]]></Name>
					<X>957</X><Y>-161</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[M]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[N]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[int d = 4;
long visitasPlano = 0;
long visitasOrigen = 0;
double sumaOrigenCuad = 0;
int conVisitaPlano = 0;
int conRetorno = 0;

for (int rep = 0; rep < M; rep++) {
    int x = 0, y = 0, z = 0, w = 0;
    int vPlano = 0;
    int vOrigen = 0;

    for (int s = 1; s <= N; s++) {
        int dir = uniform_discr(0, 2 * d - 1);

        if (dir == 0) x++;
        else if (dir == 1) x--;
        else if (dir == 2) y++;
        else if (dir == 3) y--;
        else if (dir == 4) z++;
        else if (dir == 5) z--;
        else if (dir == 6) w++;
        else if (dir == 7) w--;

        if (w == 0) {
            vPlano++;
            if (x == 0 && y == 0 && z == 0) vOrigen++;
        }
    }

    visitasPlano += vPlano;
    visitasOrigen += vOrigen;
    sumaOrigenCuad += (double) vOrigen * vOrigen;
    if (vPlano > 0) conVisitaPlano++;
    if (vOrigen > 0) conRetorno++;
}

double pVisita = (double) conVisitaPlano / M;
double pRetorno = (double) conRetorno / M;
double pCondicional = (double) conRetorno / conVisitaPlano;
double mediaPlano = (double) visitasPlano / M;
double mediaOrigen = (double) visitasOrigen / M;
double fraccion = (double) visitasOrigen / visitasPlano;

double varianzaOrigen = sumaOrigenCuad / M - mediaOrigen * mediaOrigen;
double standardError = Math.sqrt(varianzaOrigen / M);

traceln("P(visita w=0) = " + pVisita);
traceln("P(retorno) = " + pRetorno);
traceln("P(retorno | visita w=0) = " + pCondicional);
traceln("Visitas medias al plano w=0 = " + mediaPlano);
traceln("Visitas medias al origen = " + mediaOrigen
    + "  IC95%=[" + (mediaOrigen - 1.96 * standardError)
    + ", " + (mediaOrigen + 1.96 * standardError) + "]  (Polya: u-1 = 0.239467)");
traceln("Fraccion de visitas al plano que caen en el origen = " + fraccion);]]></Body>
				</Function>
			</Functions>
