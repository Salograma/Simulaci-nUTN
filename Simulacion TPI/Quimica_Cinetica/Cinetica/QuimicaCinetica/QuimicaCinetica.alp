			<Name><![CDATA[Main]]></Name>
			<AdditionalClassCode><![CDATA[public static java.util.ArrayList<double[]> arrhResults = new java.util.ArrayList<double[]>();

// k1 por unidad de área (forma diluida, sin corrección de densidad)
public static double k1Dil(double T, double Ea1, double mu, double dc, double kB) {
    return dc * Math.sqrt(2 * Math.PI * kB * T / mu) * Math.exp(-Ea1 / (kB * T));
}

// Ajuste lineal y = a + b x. Devuelve {a, b, R2, errorEstandarDeB}
public static double[] linFit(double[] x, double[] y) {
    int n = x.length;
    double sx = 0, sy = 0, sxx = 0, sxy = 0, syy = 0;
    for (int i = 0; i < n; i++) {
        sx += x[i]; sy += y[i];
        sxx += x[i] * x[i]; sxy += x[i] * y[i]; syy += y[i] * y[i];
    }
    double Sxx = sxx - sx * sx / n;
    double b = (sxy - sx * sy / n) / Sxx;
    double a = (sy - b * sx) / n;
    double ssTot = syy - sy * sy / n;
    double ssRes = 0;
    for (int i = 0; i < n; i++) {
        double e = y[i] - (a + b * x[i]);
        ssRes += e * e;
    }
    double r2 = ssTot > 0 ? 1 - ssRes / ssTot : 0;
    double seB = n > 2 ? Math.sqrt(ssRes / (n - 2) / Sxx) : 0;
    return new double[] { a, b, r2, seB };
}

// Reporte de Arrhenius: imprime CSV y los dos ajustes en la consola
public static void arrhReport(double Ea1, double kB, double mu, double dc) {
    int n = arrhResults.size();
    double[] x = new double[n], yPlain = new double[n], yMod = new double[n];
    System.out.println("T,k1_area,nReact,tEnd,1/T,ln_k,ln_k_sobre_sqrtT,k1_medido/k1_diluido");
    for (int i = 0; i < n; i++) {
        double[] r = arrhResults.get(i);
        double T = r[0], k = r[1];
        x[i] = 1.0 / T;
        yPlain[i] = Math.log(k);
        yMod[i] = Math.log(k / Math.sqrt(T));
        System.out.println(T + "," + k + "," + (int) r[2] + "," + r[3] + "," + x[i] + ","
            + yPlain[i] + "," + yMod[i] + "," + (k / k1Dil(T, Ea1, mu, dc, kB)));
    }
    double[] fP = linFit(x, yPlain);
    double[] fM = linFit(x, yMod);
    System.out.println("--- ln k vs 1/T (readme):   pendiente = " + fP[1] + " +- " + fP[3]
        + "   Ea aparente = " + (-fP[1] * kB) + "   R2 = " + fP[2]);
    System.out.println("--- ln(k/sqrt T) vs 1/T:    pendiente = " + fM[1] + " +- " + fM[3]
        + "   Ea medida   = " + (-fM[1] * kB) + "   R2 = " + fM[2]);
    System.out.println("--- Ea1 del modelo = " + Ea1);
}
]]></AdditionalClassCode>
