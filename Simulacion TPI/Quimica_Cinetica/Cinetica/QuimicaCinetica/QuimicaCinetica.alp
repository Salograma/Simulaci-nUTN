				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793384407606</Id>
					<Name><![CDATA[getEa1]]></Name>
					<X>470</X><Y>-150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// double getEa1()
return Ea1 - (catalystOn ? catDelta : 0);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793384419180</Id>
					<Name><![CDATA[getEa2]]></Name>
					<X>540</X><Y>-150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// double getEa2()   <- el catalizador baja las DOS barreras en la misma cantidad
return Ea2 - (catalystOn ? catDelta : 0);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Molecule]]></ReturnType>
					<Id>1793384440633</Id>
					<Name><![CDATA[spawn]]></Name>
					<X>400</X><Y>-120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[s]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[Molecule m = add_molecules();
m.setSpecies(s);

double x = 0, y = 0;
for (int tries = 0; tries < 200; tries++) {
    x = m.rad + random() * (Lx - 2 * m.rad);
    y = m.rad + random() * (Ly - 2 * m.rad);
    boolean ok = true;
    for (Molecule o : molecules) {
        if (o == m) continue;
        double dx = o.getX() - x, dy = o.getY() - y, d = o.rad + m.rad;
        if (dx * dx + dy * dy < d * d) { ok = false; break; }
    }
    if (ok) break;
}
m.setXY(x, y);

double sg = Math.sqrt(kB * T / m.mass);   // Maxwell 2D: cada componente ~ N(0, kT/m)
m.vx = sg * gauss();
m.vy = sg * gauss();
return m;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793384571360</Id>
					<Name><![CDATA[collide]]></Name>
					<X>470</X><Y>-120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[a]]></Name>
						<Type><![CDATA[Molecule]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[b]]></Name>
						<Type><![CDATA[Molecule]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[dx]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[dy]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[double dist = Math.sqrt(dx * dx + dy * dy);
if (dist < 1e-9) { dx = 1; dy = 0; dist = 1; }
double nx = dx / dist, ny = dy / dist;

// velocidad relativa normal (negativa = se acercan)
double vn = (b.vx - a.vx) * nx + (b.vy - a.vy) * ny;
if (vn >= 0) return;                       // ya se alejan: no hay choque

boolean ab = (a.species == 0 && b.species == 1) || (a.species == 1 && b.species == 0);
if (ab) {
    double mu = a.mass * b.mass / (a.mass + b.mass);
    double eRel = 0.5 * mu * vn * vn;
    if (eRel >= getEa1()) { react(a, b); return; }
}

// choque elástico (impulso a lo largo de la normal)
double J = -2 * vn / (1 / a.mass + 1 / b.mass);
a.vx -= J / a.mass * nx;  a.vy -= J / a.mass * ny;
b.vx += J / b.mass * nx;  b.vy += J / b.mass * ny;

// separar el solapamiento
double ov = 0.5 * (a.rad + b.rad - dist);
a.setXY(a.getX() - nx * ov, a.getY() - ny * ov);
b.setXY(b.getX() + nx * ov, b.getY() + ny * ov);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793384624184</Id>
					<Name><![CDATA[react]]></Name>
					<X>540</X><Y>-120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[a]]></Name>
						<Type><![CDATA[Molecule]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[b]]></Name>
						<Type><![CDATA[Molecule]]></Type>
					</Parameter>
					<Body><![CDATA[double M  = a.mass + b.mass;                       // masas ANTES de cambiar nada
double px = (a.mass * a.vx + b.mass * b.vx) / M;
double py = (a.mass * a.vy + b.mass * b.vy) / M;
double cx = (a.mass * a.getX() + b.mass * b.getX()) / M;
double cy = (a.mass * a.getY() + b.mass * b.getY()) / M;

a.setSpecies(2);              // ahora mass = 2, rad = 6
a.vx = px;  a.vy = py;
a.setXY(cx, cy);
b.dead = true;                // se elimina al final del paso
if (time() >= tV0Start && !v0Done) nReact++;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793384650631</Id>
					<Name><![CDATA[decompose]]></Name>
					<X>400</X><Y>-90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[c]]></Name>
						<Type><![CDATA[Molecule]]></Type>
					</Parameter>
					<Body><![CDATA[double ma = masaA, mb = masaB, M = ma + mb, mu = ma * mb / M;
double ang = random() * 2 * Math.PI;
double ux = Math.cos(ang), uy = Math.sin(ang);

// velocidad relativa muestreada de Maxwell (masa reducida mu), forzada a "alejarse"
double sg = Math.sqrt(kB * T / mu);
double rx = sg * gauss(), ry = sg * gauss();
double rn = rx * ux + ry * uy;
if (rn < 0) { rx -= 2 * rn * ux; ry -= 2 * rn * uy; }

double cx = c.getX(), cy = c.getY();
double vcx = c.vx, vcy = c.vy;             // el CM conserva el momento de C
double sep = radioA + radioB + 0.1;            // radios A + B + margen: NO nacen solapadas

Molecule b = add_molecules();
b.setSpecies(1);
c.setSpecies(0);

c.setXY(cx - mb / M * sep * ux, cy - mb / M * sep * uy);
b.setXY(cx + ma / M * sep * ux, cy + ma / M * sep * uy);

c.vx = vcx - mb / M * rx;  c.vy = vcy - mb / M * ry;
b.vx = vcx + ma / M * rx;  b.vy = vcy + ma / M * ry;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793384937363</Id>
					<Name><![CDATA[k1Theory]]></Name>
					<X>400</X><Y>-60</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double mu = masaA * masaB / (masaA + masaB);
double dc = radioA + radioB;
return dc * Math.sqrt(2 * Math.PI * kB * T / mu) * Math.exp(-getEa1() / (kB * T));
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793384980971</Id>
					<Name><![CDATA[k2c]]></Name>
					<X>560</X><Y>-60</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return A2 * Math.exp(-getEa2() / (kB * T));
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793387228616</Id>
					<Name><![CDATA[gContact]]></Name>
					<X>700</X><Y>-250</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double eta = Math.PI * (cA * radioA * radioA + cB * radioB * radioB + cC * radioC * radioC) / (Lx * Ly);
return (1 - 7 * eta / 16) / Math.pow(1 - eta, 2);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793387249396</Id>
					<Name><![CDATA[k1c]]></Name>
					<X>700</X><Y>-230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return (densCorr ? gContact() : 1.0) * k1Theory() / (Lx * Ly);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793387261526</Id>
					<Name><![CDATA[KeqTeo]]></Name>
					<X>760</X><Y>-230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return k1c() / k2c();
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793387269686</Id>
					<Name><![CDATA[CeqTeo]]></Name>
					<X>760</X><Y>-210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double K = k1c() / k2c();
double a = totalA, b = totalB;
double bq = K * (a + b) + 1;
double disc = bq * bq - 4 * K * K * a * b;
return (bq - Math.sqrt(Math.max(disc, 0))) / (2 * K);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793387277905</Id>
					<Name><![CDATA[conv]]></Name>
					<X>700</X><Y>-210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return totalA > 0 ? 100.0 * cC / totalA : 0;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793387302117</Id>
					<Name><![CDATA[KeqEst]]></Name>
					<X>830</X><Y>-230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (nSamp < 20) return 0;
double mA = sumA / nSamp, mB = sumB / nSamp, mC = sumC / nSamp;
if (mA * mB <= 0) return 0;
return mC / (mA * mB);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793387316350</Id>
					<Name><![CDATA[KeqEstAB]]></Name>
					<X>830</X><Y>-210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (nSamp < 20 || sumAB <= 0) return 0;
return (sumC / nSamp) / (sumAB / nSamp);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793387325807</Id>
					<Name><![CDATA[KeqErrRel]]></Name>
					<X>900</X><Y>-230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double e = KeqEstAB();
return e == 0 ? 0 : 100.0 * (e - KeqTeo()) / KeqTeo();
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793387342000</Id>
					<Name><![CDATA[resetStats]]></Name>
					<X>910</X><Y>-210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[sumA = 0; sumB = 0; sumC = 0; sumAB = 0;
nSamp = 0;
tStats = time() + tEq;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793393241689</Id>
					<Name><![CDATA[k1Meas]]></Name>
					<X>700</X><Y>-110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return intAB > 0 ? nReact / intAB : 0;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793393254583</Id>
					<Name><![CDATA[k1MeasArea]]></Name>
					<X>780</X><Y>-110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return k1Meas() * Lx * Ly;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793393266232</Id>
					<Name><![CDATA[v0Est]]></Name>
					<X>880</X><Y>-110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return k1Meas() * NA0 * NB0;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793393274763</Id>
					<Name><![CDATA[k1RelErr]]></Name>
					<X>950</X><Y>-110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return nReact > 0 ? 100.0 / Math.sqrt(nReact) : 0;
]]></Body>
				</Function>
